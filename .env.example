# ─────────────────────────────────────────────────────────────────────────────
# Nexo · variables de entorno. Copia a `.env` (NO se commitea) y ajusta.
# TODAS las variables viven aquí, comentadas. El arranque falla si falta una obligatoria
# (esquema Zod en apps/api/src/platform/config/env.ts).
# Las marcadas «(hito N)» todavía no las lee el código: se activan con ese hito.
# ─────────────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
PORT=4000
# URL pública de la web: origen permitido por CORS y base de los enlaces de email.
NEXO_PUBLIC_URL=http://localhost:5173
# Resolución de tenant: `session` (login único + selector de empresa; el PaaS actual no soporta
# wildcard DNS) o `subdomain` (cliente.nexo…; requiere NEXO_BASE_DOMAIN). Ver ARCHITECTURE §6.
TENANT_RESOLUTION_MODE=session
# NEXO_BASE_DOMAIN=nexo.example   # solo en modo subdomain

# ── Base de datos (3 roles; ver ARCHITECTURE §5.2) ───────────────────────────
# Pool de aplicación: rol nexo_app, SIN BYPASSRLS. api y worker lo usan para todo el negocio.
DATABASE_URL_APP=postgres://nexo_app:nexo_app_dev@localhost:5432/nexo
# Pool de plataforma: rol nexo_platform, BYPASSRLS. Solo módulos autorizados.
DATABASE_URL_PLATFORM=postgres://nexo_platform:nexo_platform_dev@localhost:5432/nexo
# SOLO para el proceso `migrate` (DDL). api/worker NO deben recibir esta variable.
DATABASE_URL_OWNER=postgres://nexo_owner:nexo_owner_dev@localhost:5432/nexo
# Contraseñas que `migrate` aplica a los roles de login (deben coincidir con las URLs de arriba).
NEXO_APP_DB_PASSWORD=nexo_app_dev
NEXO_PLATFORM_DB_PASSWORD=nexo_platform_dev

# ── Sesión y seguridad ───────────────────────────────────────────────────────
# Claves de firma de los access tokens: `kid:secreto,kid2:secreto2`. La PRIMERA firma; todas validan
# (rotación sin cortes: añade la nueva delante y retira la vieja a los 15 min). Cada secreto ≥ 32 caracteres.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SIGNING_KEYS=dev1:cambia-este-secreto-de-desarrollo-por-uno-largo-y-aleatorio
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Superadmin inicial: `pnpm db:seed` lo crea (idempotente). Quita estas dos variables después del primer arranque.
SUPERADMIN_BOOTSTRAP_EMAIL=admin@nexo.local
SUPERADMIN_BOOTSTRAP_PASSWORD=cambia-esta-contraseña-de-superadmin
# ENCRYPTION_KEYS=...         # (hito 5) AES-256-GCM para credenciales de terceros, con `key_id`

# ── Correo del sistema (invitaciones, verificación, recuperación) ─────────────
# En local, mailpit: SMTP localhost:1025 y bandeja en http://localhost:8025. OBLIGATORIA en producción.
SMTP_URL=smtp://localhost:1025
EMAIL_FROM_SYSTEM=Nexo <no-reply@nexo.local>

# ── Almacenamiento S3-compatible. En local: SeaweedFS de docker-compose ──────────
# Sin estas variables, en desarrollo los archivos van a memoria (se pierden al reiniciar). OBLIGATORIAS en producción.
S3_ENDPOINT=http://localhost:9000
# Si el navegador debe alcanzar el S3 por otra URL que la interna (p. ej. https://files.tu-dominio), indícala aquí.
# S3_PUBLIC_ENDPOINT=
S3_REGION=eu-west-1
S3_BUCKET=nexo
S3_ACCESS_KEY_ID=nexo_dev
S3_SECRET_ACCESS_KEY=nexo_dev_secret
S3_FORCE_PATH_STYLE=true

# ── Stripe (hito 2). Claves de TEST en local; las LIVE solo existen en el PaaS ─
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Resend (hito 5): correo de los tenants a sus clientes ────────────────────
# RESEND_API_KEY=...
# RESEND_WEBHOOK_SECRET=...

# ── Google / Microsoft (hito 5) ──────────────────────────────────────────────
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# MS_CLIENT_ID=...
# MS_CLIENT_SECRET=...
# MS_TENANT=common

# ── Observabilidad (opcional) ────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Demo (hito 7): credenciales del admin del tenant DEMO (no reales) ────────
# DEMO_ADMIN_EMAIL=demo@nexo.example
# DEMO_ADMIN_PASSWORD=...
