# Nexo · variables de producción para deploy/docker-compose.prod.yml. Copia a deploy/.env (NO se commitea).
# Genera cada secreto con:  node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"

# URL pública (con https). Se usa para CORS/Origin, enlaces de los correos y cookies seguras.
NEXO_PUBLIC_URL=https://nexo.kaizogroup.es
WEB_PORT=8080
LOG_LEVEL=info

# ── PostgreSQL (3 roles; ver docs/runbooks/db-roles.md) ──────────────────────
POSTGRES_SUPERUSER_PASSWORD=
NEXO_OWNER_DB_PASSWORD=
NEXO_APP_DB_PASSWORD=
NEXO_PLATFORM_DB_PASSWORD=

# ── Sesión: `kid:secreto` (≥ 32 caracteres). Para rotar, añade la nueva delante separada por coma ──
JWT_SIGNING_KEYS=k1:CAMBIAME-por-un-secreto-largo-y-aleatorio-de-48-caracteres

# ── Superadmin inicial (panel /admin/login). Quita estas dos líneas tras el primer arranque ──
SUPERADMIN_BOOTSTRAP_EMAIL=
SUPERADMIN_BOOTSTRAP_PASSWORD=

# ── Correo del sistema: SMTP real (verificación de email, invitaciones, recuperación) ──
# Ejemplo: smtps://usuario:clave@smtp.tu-proveedor.com:465   (con el perfil mail-sandbox: smtp://mailpit:1025)
SMTP_URL=
EMAIL_FROM_SYSTEM=Nexo <no-reply@kaizogroup.es>

# ── Almacenamiento S3 (SeaweedFS del propio compose por defecto) ─────────────
S3_ACCESS_KEY_ID=nexo
S3_SECRET_ACCESS_KEY=
S3_BUCKET=nexo
# S3_ENDPOINT=http://s3:8333
# URL del S3 alcanzable desde el navegador (solo cuando se usen subidas/descargas de archivos).
# S3_PUBLIC_ENDPOINT=
